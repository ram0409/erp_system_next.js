# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. Never commit `.env`.
# Every variable below is validated on boot by src/config/env.ts — a missing or
# malformed value fails fast at startup instead of at the first request.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
NODE_ENV=development

# Database ------------------------------------------------------------------
# Credentials consumed by docker-compose.yml. POSTGRES_PASSWORD has no default
# on purpose: the container refuses to start until you choose one.
POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=erp_dev
POSTGRES_PORT=5432

# Must match the values above when using the bundled container.
DATABASE_URL=postgresql://erp:CHANGE_ME@localhost:5432/erp_dev?schema=public
# Separate database used by integration tests (created by docker/postgres/init).
TEST_DATABASE_URL=postgresql://erp:CHANGE_ME@localhost:5432/erp_test?schema=public

# Authentication ------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Session lifetime, in seconds (eight hours).
SESSION_MAX_AGE_SECONDS=28800

# Brute-force protection ----------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Password reset ------------------------------------------------------------
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Outbound mail (password reset). Leave blank in development to log the reset
# link to the server console instead of sending mail.
#
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587,
# SMTP_PASSWORD=the xkeysib- API/SMTP key, SMTP_FROM=a verified Brevo sender.
# SMTP_USER is only needed for SMTP login (from SMTP & API). Leave it blank to
# send through Brevo's HTTPS API with the key alone.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Database seed -------------------------------------------------------------
# Consumed only by `npm run db:seed`, which is idempotent. Leave
# SEED_ADMIN_PASSWORD blank and the seed generates a compliant password, prints
# it once, and requires a change at first sign-in. Re-seeding never overwrites
# the password of an account that already exists.
SEED_ORG_NAME=Netkathir Enterprises
SEED_ORG_CODE=NK
SEED_BRANCH_CODE=HO
SEED_BRANCH_NAME=Head Office
SEED_ADMIN_EMAIL=systemadmin@sample.com
SEED_ADMIN_EMPLOYEE_CODE=systemadmin.sample
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
SEED_ADMIN_PASSWORD=
# Set to true only when you intentionally want the seed to overwrite the
# existing Super Admin password. Leave blank otherwise.
SEED_ADMIN_RESET_PASSWORD=

# Public (exposed to the browser — never put a secret here) ------------------
NEXT_PUBLIC_APP_NAME=Netkathir ERP
NEXT_PUBLIC_APP_URL=http://localhost:3000
